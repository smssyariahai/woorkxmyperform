generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id                 String           @id @default(cuid())
  name               String
  slug               String           @unique
  logo               String?
  industry           String?
  teamSize           String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  isActive           Boolean          @default(true)
  modules            String           @default("[]")
  subdomain          String?          @unique
  description        String?
  tagline            String?
  phone              String?
  email              String?
  address            String?
  website            String?
  logoPath           String?
  coverPath          String?
  subdomainChangedAt DateTime?
  activities         Activity[]
  agents             Agent[]
  agentTasks         AgentTask[]
  approvals          Approval[]
  auditLogs          AuditLog[]
  botConfig          BotConfig?
  bots               BotFlow[]
  botUsage           BotUsage[]
  campaigns          Campaign[]
  channels           Channel[]
  channelAccounts    ChannelAccount[]
  conversations      Conversation[]
  creditLedger       CreditLedger[]
  customers          Customer[]
  deals              Deal[]
  dealStages         DealStage[]
  masterLedger       MasterLedger[]
  departments        Department[]
  customFieldDefs    UserCustomFieldDef[]
  followUps          FollowUp[]
  hrCandidates       HrCandidate[]
  hrContracts        HrContract[]
  hrEmployees        HrEmployee[]
  hrVacancies        HrVacancy[]
  esignDocuments     EsignDocument[]
  esignTemplates     EsignTemplate[]
  invitations        Invitation[]
  leads              Lead[]
  leadStages         LeadStage[]
  memberships        Membership[]
  notes              Note[]
  officeLayouts      OfficeLayout[]
  notifications      Notification[]
  quranBookmarks     QuranBookmark[]
  prayerUserSettings PrayerUserSetting[]
  goldPriceHistories GoldPriceHistory[]
  goldSettings       GoldSetting[]
  kirimUrls          KirimUrl[]
  simulations        Simulation[]
  announcements        Announcement[]
  notificationPreferences NotificationPreference[]
  talTasks             TalTask[]
  talRoutineTemplates  TalRoutineTemplate[]
  talMonthlyLocks      TalMonthlyLock[]
  talLockReports       TalLockReport[]
  talCutis             TalCuti[]
  talHolidays          TalHoliday[]
  talBadges            TalBadge[]
  userBadgeProgress    UserBadgeProgress[]
  userTrophies         UserTrophy[]
  talSettings          TalSetting[]
  talDeadlineSetting   TalDeadlineSetting?
  talUserObligations   TalUserObligation[]
  talTeamVisibilities  TalTeamVisibility[]
  talAuditLogs         TalAuditLog[]
  koperasiAnggota      KoperasiAnggota[]
  koperasiSettings     KoperasiSetting[]
  tickets              Ticket[]
  archiveCategories    ArchiveCategory[]
  archiveDocuments     ArchiveDocument[]
  meetings             Meeting[]
  meetingSettings      MeetingSetting?
  replyTemplates     ReplyTemplate[]
  roles              Role[]
  sessions           Session[]
  subscription       Subscription?
  invoices           Invoice[]
  tags               Tag[]
  topUpRequests      TopUpRequest[]

  @@index([slug])
}

model Agent {
  id                 String          @id @default(cuid())
  organizationId     String
  name               String
  role               String
  description        String          @default("")
  avatarColor        String          @default("#007AFD")
  skills             String          @default("[]")
  systemInstructions String          @default("")
  tools              String          @default("[]")
  currentStatus      String          @default("IDLE")
  currentTaskId      String?
  isEnabled          Boolean         @default(true)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  organization       Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  activities         AgentActivity[]
  layouts            OfficeLayout[]
  receivedMessages   AgentMessage[]  @relation("MsgReceiver")
  sentMessages       AgentMessage[]  @relation("MsgSender")
  tasks              AgentTask[]     @relation("TaskAgent")
  requestedApprovals Approval[]      @relation("ApprovalRequester")

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([organizationId, currentStatus])
}

model AgentTask {
  id               String         @id @default(cuid())
  organizationId   String
  title            String
  description      String         @default("")
  agentId          String?
  createdById      String?
  priority         String         @default("NORMAL")
  status           String         @default("QUEUED")
  progress         Int            @default(0)
  inputPayload     String         @default("{}")
  resultPayload    String?
  errorMessage     String?
  attempts         Int            @default(0)
  maxAttempts      Int            @default(3)
  requiresApproval Boolean        @default(false)
  createdAt        DateTime       @default(now())
  startedAt        DateTime?
  completedAt      DateTime?
  updatedAt        DateTime       @updatedAt
  messages         AgentMessage[]
  agent            Agent?         @relation("TaskAgent", fields: [agentId], references: [id])
  createdBy        User?          @relation("AgentTaskCreator", fields: [createdById], references: [id])
  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  approvals        Approval[]
  events           TaskEvent[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([agentId])
}

model TaskEvent {
  id             String    @id @default(cuid())
  organizationId String
  taskId         String
  eventType      String
  message        String    @default("")
  payload        String    @default("{}")
  createdAt      DateTime  @default(now())
  task           AgentTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([taskId, createdAt])
}

model AgentMessage {
  id              String     @id @default(cuid())
  organizationId  String
  conversationId  String
  senderAgentId   String
  receiverAgentId String
  taskId          String?
  content         String
  status          String     @default("SENT")
  createdAt       DateTime   @default(now())
  receiver        Agent      @relation("MsgReceiver", fields: [receiverAgentId], references: [id], onDelete: Cascade)
  sender          Agent      @relation("MsgSender", fields: [senderAgentId], references: [id], onDelete: Cascade)
  task            AgentTask? @relation(fields: [taskId], references: [id])

  @@index([conversationId])
  @@index([taskId])
}

model AgentActivity {
  id             String    @id @default(cuid())
  organizationId String
  agentId        String
  activityType   String
  description    String    @default("")
  startedAt      DateTime  @default(now())
  endedAt        DateTime?
  metadata       String    @default("{}")
  agent          Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([agentId, startedAt])
}

model Approval {
  id                 String       @id @default(cuid())
  organizationId     String
  taskId             String
  requestedByAgentId String?
  approvalType       String       @default("GENERAL")
  description        String       @default("")
  status             String       @default("PENDING")
  reviewedById       String?
  reviewedAt         DateTime?
  createdAt          DateTime     @default(now())
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requestedBy        Agent?       @relation("ApprovalRequester", fields: [requestedByAgentId], references: [id])
  reviewedBy         User?        @relation("ApprovalReviewer", fields: [reviewedById], references: [id])
  task               AgentTask    @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([taskId])
}

model User {
  id                String                @id @default(cuid())
  name              String
  email             String                @unique
  username          String?               @unique
  password          String?
  avatar            String?
  phone             String?
  status            String                @default("ACTIVE")
  emailVerified     DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  isSuperAdmin      Boolean               @default(false)
  activities        Activity[]            @relation("ActivityActor")
  createdAgentTasks AgentTask[]           @relation("AgentTaskCreator")
  reviewedApprovals Approval[]            @relation("ApprovalReviewer")
  auditLogs         AuditLog[]
  createdCampaigns  Campaign[]            @relation("CampaignCreator")
  assignedConvos    Conversation[]        @relation("ConversationAssignee")
  sentMessages      ConversationMessage[] @relation("MessageSender")
  ownedCustomers    Customer[]            @relation("CustomerOwner")
  ownedDeals        Deal[]                @relation("DealOwner")
  assignedFollowUps FollowUp[]            @relation("FollowUpAssignee")
  hrCandidates      HrCandidate[]         @relation("HrCandidateAuthor")
  hrContracts       HrContract[]          @relation("HrContractAuthor")
  hrEmployees       HrEmployee[]          @relation("HrEmployeeAuthor")
  hrVacancies       HrVacancy[]           @relation("HrVacancyAuthor")
  esignDocuments    EsignDocument[]       @relation("EsignDocumentAuthor")
  esignApprovals    EsignDocument[]       @relation("EsignDocumentApprover")
  esignSigners      EsignSigner[]         @relation("EsignSignerUser")
  esignProfile      EsignProfile?
  esignTemplates    EsignTemplate[]       @relation("EsignTemplateAuthor")
  esignAuditLogs    EsignAuditLog[]       @relation("EsignAuditLogUser")
  esignNotifications EsignNotification[]  @relation("EsignNotificationRecipient")
  profile           UserProfile?
  familyContacts    UserFamilyContact[]
  educations        UserEducation[]
  workExperiences   UserWorkExperience[]
  managedEmployments UserEmployment[]      @relation("EmploymentManager")
  approvedEmployments UserEmployment[]     @relation("EmploymentApprover")
  sentInvitations   Invitation[]          @relation("InvitationSender")
  ownedLeads        Lead[]                @relation("LeadOwner")
  memberships       Membership[]
  authoredNotes     Note[]                @relation("NoteAuthor")
  platformRoleAssignments PlatformRoleAssignment[]
  notifications     Notification[]
  announcements        Announcement[]   @relation("AnnouncementAuthor")
  notificationPreferences NotificationPreference[]
  talTasks             TalTask[]
  talRoutineTemplates  TalRoutineTemplate[]
  talMonthlyLocks      TalMonthlyLock[]
  talLockReports       TalLockReport[]
  talCutis             TalCuti[]
  userBadgeProgress    UserBadgeProgress[]
  userTrophies         UserTrophy[]
  talUserObligations   TalUserObligation[]
  talTeamVisibilityAsViewer TalTeamVisibility[] @relation("TalTeamViewer")
  talTeamVisibilityAsTarget TalTeamVisibility[] @relation("TalTeamTarget")
  talTeamVisibilityCreated  TalTeamVisibility[] @relation("TalTeamCreator")
  talAuditLogs         TalAuditLog[]
  quranBookmarks    QuranBookmark[]
  prayerUserSetting PrayerUserSetting?
  simulations       Simulation[]
  createdTickets    Ticket[]      @relation("TicketCreator")
  assignedTickets   Ticket[]      @relation("TicketAssignee")
  ticketReplies     TicketReply[]
  meetingsHosted    Meeting[]     @relation("MeetingHost")
  meetingParticipations MeetingParticipant[] @relation("MeetingParticipantUser")
  archiveCategoriesCreated ArchiveCategory[] @relation("ArchiveCategoryCreator")
  archiveDocuments  ArchiveDocument[] @relation("ArchiveDocumentUploader")
  resetTokens       PasswordResetToken[]
  createdTemplates  ReplyTemplate[]       @relation("TemplateAuthor")
  sessions          Session[]

  @@index([email])
  @@index([status])
}

model Role {
  id             String           @id @default(cuid())
  organizationId String?
  name           String
  description    String?
  isSystem       Boolean          @default(false)
  createdAt      DateTime         @default(now())
  invitations    Invitation[]
  memberships    Membership[]
  organization   Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions    RolePermission[]
  platformAssignments PlatformRoleAssignment[]

  @@unique([organizationId, name])
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  description String?
  module      String           @default("Umum")
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Membership {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  roleId         String
  status         String       @default("ACTIVE")
  joinedAt       DateTime     @default(now())
  departmentId   String?
  jobTitle       String?
  department     Department?  @relation(fields: [departmentId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           Role         @relation(fields: [roleId], references: [id])
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  employment     UserEmployment?
  customValues   UserCustomValue[]
  moduleAccess   UserModuleAccess[]

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
  @@index([departmentId])
}

// Data personal pengguna (Sidebar 1 — Info Personal Data).
// Satu profil per User (berlaku lintas kantor); data ketenagakerjaan
// justru per Membership (UserEmployment) karena bisa berbeda per kantor.
model UserProfile {
  id             String    @id @default(cuid())
  userId         String    @unique
  birthDate      DateTime?
  gender         String? // 'L' | 'P'
  maritalStatus  String? // Lajang | Menikah | Cerai
  bloodType      String? // A | B | AB | O
  religion       String? // Katolik | Islam | Kristen | Buddha | Hindu | Konghucu | Lainnya
  nik            String?
  ktpAddress     String?
  postalCode     String?
  homeAddress    String? // Alamat tempat tinggal (bila berbeda dari KTP)
  docAccessLevel String?   @default("INTERNAL") // UMUM | INTERNAL | RAHASIA
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([nik])
}

// Kontak keluarga/kerabat pengguna (Sidebar 1 — Info Kontak Keluarga).
model UserFamilyContact {
  id           String   @id @default(cuid())
  userId       String
  name         String
  relationship String // Ayah | Ibu | Saudara Kandung | Pasangan | Anak | ...
  phone        String?
  address      String?
  occupation   String?
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Info ketenagakerjaan (Sidebar 2) — satu per Membership (per kantor).
model UserEmployment {
  id                String      @id @default(cuid())
  membershipId      String      @unique
  companyName       String?
  employeeId        String? // ID karyawan
  organizationName  String? // Nama organisasi / unit
  position          String? // Posisi pekerjaan
  jobLevel          String? // Tingkat jabatan
  employmentStatus  String? // Tetap | Kontrak | Magang | Freelance | Percobaan
  branch            String? // Cabang
  joinDate          DateTime?
  endDate           DateTime? // Tanggal berakhirnya status kepegawaian
  grade             String? // Golongan
  classLevel        String? // Kelas
  managerId         String? // Manajer / Atasan Langsung (User di kantor yang sama)
  approvalApproverId String? // Alur persetujuan bila berbeda dari atasan langsung
  approvalNote      String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  membership        Membership  @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  manager           User?       @relation("EmploymentManager", fields: [managerId], references: [id])
  approver          User?       @relation("EmploymentApprover", fields: [approvalApproverId], references: [id])

  @@index([employeeId])
}

// Pendidikan formal & informal (Sidebar 2 — Pendidikan & Pengalaman).
model UserEducation {
  id             String    @id @default(cuid())
  userId         String
  kind           String // FORMAL | INFORMAL
  degree         String? // Derajat pendidikan formal (lihat FORMAL_DEGREES)
  name           String? // Nama pendidikan informal
  institution    String? // Institusi (formal) / Dipegang oleh (informal)
  fieldOfStudy   String? // Bidang studi (formal)
  grade          String? // Grade (formal)
  startYear      Int?
  endYear        Int?
  expiryDate     DateTime? // Tanggal kedaluwarsa (informal)
  cost           Int? // Biaya (informal, rupiah)
  activity       String? // Kegiatan
  hasCertificate Boolean   @default(false)
  certificatePath String? // Lampiran sertifikat (path di uploads/users/)
  sortOrder      Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Pengalaman kerja (Sidebar 2).
model UserWorkExperience {
  id          String   @id @default(cuid())
  userId      String
  companyName String
  position    String
  startYear   Int?
  endYear     Int?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Definisi field custom per kantor (Sidebar 3 — Info Tambahan).
model UserCustomFieldDef {
  id             String            @id @default(cuid())
  organizationId String
  label          String
  type           String // SHORT_TEXT | LONG_TEXT | NUMBER | CURRENCY | DATE | TIME | SELECT | BOOLEAN | EMAIL | PHONE | URL | FILE
  options        String? // JSON array string — pilihan untuk tipe SELECT
  required       Boolean           @default(false)
  sortOrder      Int               @default(0)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  values         UserCustomValue[]

  @@index([organizationId])
}


// Nilai field custom per Membership (per kantor).
model UserCustomValue {
  id           String             @id @default(cuid())
  membershipId String
  fieldDefId   String
  value        String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  membership   Membership         @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  fieldDef     UserCustomFieldDef @relation(fields: [fieldDefId], references: [id], onDelete: Cascade)

  @@unique([membershipId, fieldDefId])
  @@index([membershipId])
}

// Hak akses modul per pengguna (Sidebar 4) — override per user.
// Tanpa baris = ikut aturan kantor (modul paket). Baris allowed=false
// = modul itu dicabut untuk user ini (ditegakkan di assertPermission).
model UserModuleAccess {
  id           String     @id @default(cuid())
  membershipId String
  moduleKey    String // kunci modul baru (chat | hris | audit | dashboard | setting) atau kunci lama (inbox | crm | hr | ...)
  allowed      Boolean    @default(true)
  access       String     @default("WRITE") // READ | WRITE | NONE (baris lama allowed=false = NONE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([membershipId, moduleKey])
  @@index([membershipId])
}

// Penugasan role platform (Admin WOORK, Fase 1 RBAC).
// Berbeda dari Membership: tidak terikat satu tenant. Role yang ditugaskan
// HARUS role platform (Role.organizationId null); penegakannya di API,
// bukan di constraint database. Akses platform dicek lewat
// requirePlatformPermission, terpisah dari permission tenant.
model PlatformRoleAssignment {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

model Department {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  description    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships    Membership[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Channel {
  id             String           @id @default(cuid())
  organizationId String
  type           String
  name           String
  status         String           @default("DISCONNECTED")
  createdAt      DateTime         @default(now())
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  accounts       ChannelAccount[]
  conversations  Conversation[]

  @@unique([organizationId, type])
  @@index([organizationId])
}

model ChannelAccount {
  id             String       @id @default(cuid())
  organizationId String
  channelId      String
  externalId     String?
  displayName    String?
  credentials    String       @default("{}")
  verifyToken    String?
  status         String       @default("DISCONNECTED")
  lastTestAt     DateTime?
  lastTestOk     Boolean?
  lastError      String?
  connectedAt    DateTime?
  createdAt      DateTime     @default(now())
  channel        Channel      @relation(fields: [channelId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Customer {
  id             String              @id @default(cuid())
  organizationId String
  name           String
  phone          String?
  email          String?
  company        String?
  industry       String?
  source         String?
  business       String?
  interest       String?
  budget         String?
  stage          String              @default("Baru")
  score          String?
  ownerId        String?
  unreadCount    Int                 @default(0)
  lastMessageAt  DateTime?
  lastPurchase   String?
  nextFollowUp   DateTime?
  meta           String              @default("{}")
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  waLid          String?
  // Foto profil WA (disajikan via /api/customers/photo); null bila belum ada / privasi kontak menutup.
  photoUrl       String?
  // Terakhir kali foto profil WA dicek (berhasil maupun gagal) — dipakai untuk jeda refresh 7 hari.
  photoCheckedAt DateTime?
  activities     Activity[]
  recipients     CampaignRecipient[]
  conversations  Conversation[]
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner          User?               @relation("CustomerOwner", fields: [ownerId], references: [id])
  tags           CustomerTag[]
  deals          Deal[]
  followUps      FollowUp[]
  lead           Lead?
  notes          Note[]

  @@index([organizationId])
  @@index([organizationId, stage])
  @@index([phone])
  @@index([email])
  @@index([ownerId])
  @@index([updatedAt])
}

model Tag {
  id             String        @id @default(cuid())
  organizationId String
  name           String
  color          String        @default("#087BFF")
  createdAt      DateTime      @default(now())
  customers      CustomerTag[]
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
}

model CustomerTag {
  customerId String
  tagId      String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([customerId, tagId])
}

model Conversation {
  id             String                @id @default(cuid())
  organizationId String
  customerId     String
  channelId      String?
  channelType    String                @default("WHATSAPP")
  status         String                @default("NEW")
  assignedTo     String                @default("WOO")
  assigneeId     String?
  lastMessageAt  DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  botEnabled     Boolean               @default(true)
  assignee       User?                 @relation("ConversationAssignee", fields: [assigneeId], references: [id])
  channel        Channel?              @relation(fields: [channelId], references: [id])
  customer       Customer              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  messages       ConversationMessage[]

  @@index([organizationId])
  @@index([customerId])
  @@index([organizationId, status])
  @@index([lastMessageAt])
}

model ConversationMessage {
  id             String       @id @default(cuid())
  conversationId String
  senderType     String
  senderId       String?
  body           String
  messageType    String       @default("TEXT")
  metadata       String       @default("{}")
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User?        @relation("MessageSender", fields: [senderId], references: [id])

  @@index([conversationId])
  @@index([createdAt])
}

model Note {
  id             String       @id @default(cuid())
  organizationId String
  customerId     String
  authorId       String
  body           String
  createdAt      DateTime     @default(now())
  author         User         @relation("NoteAuthor", fields: [authorId], references: [id])
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model Activity {
  id             String       @id @default(cuid())
  organizationId String
  customerId     String?
  actorId        String?
  type           String
  title          String
  description    String?
  createdAt      DateTime     @default(now())
  actor          User?        @relation("ActivityActor", fields: [actorId], references: [id])
  customer       Customer?    @relation(fields: [customerId], references: [id], onDelete: Cascade)
