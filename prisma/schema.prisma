// ---------------------------------------------------------------------------
// Modul Tiket — baru (Bagian 3, 2026-11-19).
// Tiket dukungan internal per kantor: dibuat user kantor, ditangani admin
// kantor (TIKET_MANAGE), diawasi Administrator Pusat lewat /admin/tiket.
// Tanpa lampiran file di v1. Kategori/prioritas/status disimpan sebagai
// string (pola AgentTask/TalTask), bukan enum — nilai baru tidak butuh
// migrasi. Notifikasi memakai model Notification (type 'TIKET').
// ---------------------------------------------------------------------------
model Ticket {
  id             String       @id @default(cuid())
  organizationId String
  createdById    String
  title          String
  category       String       @default("Umum") // Teknis/IT | HRD | Keuangan | Umum
  priority       String       @default("normal") // rendah | normal | tinggi | mendesak
  status         String       @default("TERBUKA") // TERBUKA | DIPROSES | MENUNGGU_BALASAN | SELESAI | DITUTUP
  description    String       @default("") @db.Text
  assignedToId   String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      User         @relation("TicketCreator", fields: [createdById], references: [id], onDelete: Cascade)
  assignedTo     User?        @relation("TicketAssignee", fields: [assignedToId], references: [id])
  replies        TicketReply[]

  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@index([createdById])
  @@index([assignedToId])
}

model TicketReply {
  id        String   @id @default(cuid())
  ticketId  String
  authorId  String
  content   String   @db.Text
  createdAt DateTime @default(now())
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

// ---------------------------------------------------------------------------
// Modul E-Arsip — baru (2026-11-19, Item 2).
// Arsip dokumen internal per kantor: kategori (mendukung subkategori via
// self-relation parentId) + dokumen dengan satu file per dokumen.
// Kerahasiaan/confidentiality & status disimpan sebagai string (pola
// Ticket), bukan enum — nilai baru tidak butuh migrasi.
// confidentiality: PUBLIC | INTERNAL | CONFIDENTIAL. Dokumen CONFIDENTIAL
// hanya boleh dilihat/diunduh Super Admin atau pemegang EARSIP_MANAGE
// (ditegakkan di BACKEND pada setiap endpoint baca/file, lib/earsip).
// status: ACTIVE | ARCHIVED (arsipkan = ubah status, bukan hapus).
// File disimpan di uploads/earsip/<organizationId>/, DB hanya menyimpan
// path relatif (pola Koperasi). TIDAK ADA tabel versi dokumen (ditunda)
// dan TIDAK ADA tabel log aktivitas arsip — aktivitas dicatat ke AuditLog
// existing via lib/audit.ts.
// ---------------------------------------------------------------------------
model ArchiveCategory {
  id             String            @id @default(cuid())
  organizationId String
  name           String
  description    String?
  parentId       String?
  createdById    String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent         ArchiveCategory?  @relation("ArchiveCategoryParent", fields: [parentId], references: [id], onDelete: Cascade)
  children       ArchiveCategory[] @relation("ArchiveCategoryParent")
  createdBy      User?             @relation("ArchiveCategoryCreator", fields: [createdById], references: [id])
  documents      ArchiveDocument[]

  @@index([organizationId])
  @@index([organizationId, parentId])
}

model ArchiveDocument {
  id              String          @id @default(cuid())
  organizationId  String
  categoryId      String
  title           String
  documentNumber  String?
  documentDate    DateTime?
  description     String?         @db.Text
  filePath        String // path relatif: uploads/earsip/<organizationId>/<file>
  fileName        String
  fileSize        Int
  mimeType        String
  uploaderId      String
  confidentiality String          @default("INTERNAL") // PUBLIC | INTERNAL | CONFIDENTIAL
  status          String          @default("ACTIVE") // ACTIVE | ARCHIVED
  uploadedAt      DateTime        @default(now())
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category        ArchiveCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  uploader        User            @relation("ArchiveDocumentUploader", fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, categoryId])
  @@index([organizationId, status])
  @@index([organizationId, confidentiality])
  @@index([organizationId, uploadedAt])
  @@index([uploaderId])
}

model Meeting {
  id                  String   @id @default(cuid())
  organizationId      String
  hostId              String // User pembuat/host
  title               String
  description         String?  @db.Text
  startsAt            DateTime // simpan UTC; tampilkan Asia/Jakarta (tidak ada timezone di User)
  endsAt              DateTime?
  timezone            String   @default("Asia/Jakarta")
  meetingType         String   @default("INTERNAL") // INTERNAL | EXTERNAL | DEPARTMENT | BRANCH | MANAGEMENT | TRAINING | WEBINAR | INTERVIEW
  locationType        String   @default("ONLINE") // ONLINE | OFFLINE | HYBRID
  joinUrl             String? // tautan eksternal (Zoom/Meet) bila dipakai; kosong bila video internal
  location            String? // alamat bila offline/hybrid
  status              String   @default("SCHEDULED") // DRAFT | SCHEDULED | ONGOING | COMPLETED | CANCELLED
  password            String? // hash bila meeting memakai password (jangan simpan plaintext)
  waitingRoom         Boolean  @default(false)
  allowJoinBeforeHost Boolean  @default(false)
  muteOnEntry         Boolean  @default(false)
  allowScreenShare    Boolean  @default(true)
  allowChat           Boolean  @default(true)
  allowRecording      Boolean  @default(false)
  isRecurring         Boolean  @default(false)
  recurrenceRule      String? // RRULE; atau Json — putuskan di Fase 2
  roomName            String?  @unique // mis. "meet_<id>"; nama room video internal (agnostik engine)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  organization        Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  host                User               @relation("MeetingHost", fields: [hostId], references: [id])
  participants        MeetingParticipant[]
  agendaItems         MeetingAgendaItem[]
  notes               MeetingNote[]
  recordings          MeetingRecording[]
  chatMessages        MeetingChatMessage[]
  sessions            MeetingSession[]
  guestTokens         MeetingGuestToken[]

  @@index([organizationId, startsAt])
  @@index([organizationId, status])
  @@index([hostId])
}

model MeetingParticipant {
  id                 String   @id @default(cuid())
  meetingId          String
  userId             String? // null = tamu eksternal (snapshot di bawah, pola EsignSigner)
  guestName          String?
  guestEmail         String?
  guestPhone         String?
  snapshotPosition   String? // jabatan saat diundang
  snapshotDepartment String?
  snapshotBranch     String? // string bebas (tidak ada model Branch)
  role               String   @default("PARTICIPANT") // HOST | CO_HOST | PARTICIPANT
  isRequired         Boolean  @default(true)
  status             String   @default("INVITED") // INVITED | ACCEPTED | DECLINED | TENTATIVE | ATTENDED | ABSENT
  respondedAt        DateTime?
  joinedAt           DateTime?
  leftAt             DateTime?
  meeting            Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user               User?    @relation("MeetingParticipantUser", fields: [userId], references: [id])
  guestToken         MeetingGuestToken?

  @@unique([meetingId, userId]) // tamu (userId null) perlu penanganan khusus di Fase 2
  @@index([meetingId])
  @@index([userId])
}

// Token tamu publik — pola EsignSigner.accessToken (randomUUID, TTL, cabut dengan null).
model MeetingGuestToken {
  id             String    @id @default(cuid())
  meetingId      String
  participantId  String    @unique
  accessToken    String    @unique
  tokenExpiresAt DateTime?
  scope          String    @default("JOIN") // JOIN | VIEW
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())
  meeting        Meeting            @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  participant    MeetingParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([meetingId])
}

model MeetingSession { // jejak join/leave per kehadiran (bukan sesi NextAuth)
  id              String   @id @default(cuid())
  meetingId       String
  participantId   String?
  userId          String?
  guestName       String?
  joinedAt        DateTime @default(now())
  leftAt          DateTime?
  durationSeconds Int?
  meeting         Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId])
}

model MeetingChatMessage { // chat DALAM meeting — terpisah dari chat kantor (Conversation wajib customerId)
  id          String   @id @default(cuid())
  meetingId   String
  senderId    String? // null = tamu (nama dari snapshot)
  senderName  String
  body        String   @db.Text
  isPrivate   Boolean  @default(false)
  recipientId String? // bila private message
  createdAt   DateTime @default(now())
  meeting     Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId, createdAt])
}

model MeetingRecording { // pola ArchiveDocument (file + kerahasiaan)
  id              String   @id @default(cuid())
  meetingId       String
  filePath        String // relatif uploads/meet/<orgId>/ — pola ArchiveDocument.filePath
  fileName        String
  fileSize        Int
  mimeType        String
  durationSeconds Int?
  uploaderId      String
  confidentiality String   @default("INTERNAL") // PUBLIC | INTERNAL | CONFIDENTIAL
  status          String   @default("ACTIVE") // ACTIVE | ARCHIVED
  createdAt       DateTime @default(now())
  meeting         Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId])
}

model MeetingSetting { // pengaturan per kantor (pola KoperasiSetting)
  id                   String   @id @default(cuid())
  organizationId       String   @unique
  maxDurationMinutes   Int      @default(120)
  maxParticipants      Int      @default(50)
  waitingRoomDefault   Boolean  @default(false)
  allowGuest           Boolean  @default(true)
  allowScreenShare     Boolean  @default(true)
  allowChat            Boolean  @default(true)
  allowRecording       Boolean  @default(false)
  recordingRetentionDays Int    @default(30)
  defaultTimezone      String   @default("Asia/Jakarta")
  updatedAt            DateTime @updatedAt
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model MeetingAgendaItem {
  id              String   @id @default(cuid())
  meetingId       String
  title           String
  description     String?  @db.Text
  durationMinutes Int?
  order           Int      @default(0)
  presenterId     String?
  status          String   @default("PENDING")
  meeting         Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId])
}

model MeetingNote { // notulen — pola TicketReply
  id        String   @id @default(cuid())
  meetingId String
  authorId  String
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId])
}
