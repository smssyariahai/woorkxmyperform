// Koperasi — porting MyPerform Gelombang 5 (fondasi 2026-11-13).
// Sumber: db/postgres/012_koperasi_anggota.sql (backup-main-2026-11-02).
// Foto KTP / foto anggota / tanda tangan di backup disimpan sebagai data URL
// (kolom foto_* TEXT); di WOORK disimpan sebagai FILE di disk
// (uploads/koperasi/, pola app/api/customers/photo +
// app/api/esign/profile/signature) — kolom foto_* di sini menyimpan PATH
// RELATIF (mis. "ktp-<id>.jpg"), BUKAN data URL.
// ---------------------------------------------------------------------------

model KoperasiAnggota {
  id                  String    @id @default(cuid())
  organizationId      String
  cabang              String    @default("")
  nik                 String
  namaLengkap         String
  tempatLahir         String    @default("")
  tanggalLahir        DateTime? @db.Date
  jenisKelamin        String    @default("")
  alamatKtp           String    @default("") @db.Text
  noHp                String    @default("")
  namaIbuKandung      String    @default("")
  pekerjaan           String    @default("")
  statusPerkawinan    String    @default("")
  penghasilanBulanan  String    @default("")
  tujuanKeanggotaan   String    @default("")
  fotoKtpPath         String    @default("")
  fotoAnggotaPath     String    @default("")
  tandaTanganPath     String    @default("")
  setujuMobileBanking Boolean   @default(false)
  setujuPernyataan    Boolean   @default(false)
  // Status kepemilikan produk; diisi modul Rekening Simpanan &
  // Pembiayaan saat modul itu tersedia (saat ini selalu false).
  hasSimpanan         Boolean   @default(false)
  hasPinjaman         Boolean   @default(false)
  createdBy           String    @default("")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
