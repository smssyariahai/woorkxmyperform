// ===================== E-Sign (tanda tangan elektronik internal) =====================
// BUKAN tanda tangan elektronik tersertifikasi PSrE. Hash SHA-256, gambar tanda
// tangan, dan audit trail adalah mekanisme pendukung integritas, bukan
// pengganti sertifikat elektronik tersertifikasi.

model EsignDocument {
  id               String    @id @default(cuid())
  organizationId   String
  documentNumber   String
  title            String
  category         String
  description      String?
  originalFilePath String?
  finalFilePath    String?
  originalHash     String?
  finalHash        String?
  // Teks hasil ekstraksi PDF (untuk AI-Agent menjawab isi dokumen).
  // NULL = belum diekstrak; '' = sudah diekstrak tapi tidak ada teks (scan).
  extractedText    String?
  createdById      String
  // Status dokumen:
  // DRAFT = baru dibuat, belum dikirim
  // PENDING_APPROVAL = menunggu persetujuan sebelum tanda tangan
  // PENDING_SIGNATURE = menunggu tanda tangan
  // PARTIALLY_SIGNED = sebagian penandatangan sudah selesai
  // SIGNED = semua penandatangan sudah selesai, PDF final belum dibuat
  // COMPLETED = PDF final dibuat + hash final tersimpan
  // REJECTED / CANCELLED / EXPIRED
  status           String    @default("DRAFT")
  workflowType     String    @default("SEQUENTIAL")
  approvalStatus   String    @default("NOT_REQUIRED")
  approverId       String?
  currentStep      Int       @default(0)
  expiresAt        DateTime?
  completedAt      DateTime?
  // Tampilan elemen tanda tangan di PDF final (preferensi rendering).
  showSignerName     Boolean @default(true)
  showSignerPosition Boolean @default(true)
  showSignedDate     Boolean @default(true)
  showDocRef         Boolean @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy        User      @relation("EsignDocumentAuthor", fields: [createdById], references: [id])
  approver         User?     @relation("EsignDocumentApprover", fields: [approverId], references: [id])
  signers          EsignSigner[]
  signatures       EsignSignature[]
  auditLogs        EsignAuditLog[]
  notifications    EsignNotification[]

  @@unique([organizationId, documentNumber])
  @@index([organizationId])
  @@index([organizationId, status])
}

model EsignSigner {
  id               String    @id @default(cuid())
  documentId       String
  userId           String
  signerName       String
  signerEmail      String?
  signerPhone      String?
  signerPosition   String?
  signerDepartment String?
  signingOrder     Int
  signingStatus    String    @default("PENDING")
  placementPage    Int?
  placementX       Float?
  placementY       Float?
  placementWidth   Float?
  placementHeight  Float?
  accessToken      String?   @unique
  tokenExpiresAt   DateTime?
  signedAt         DateTime?
  rejectedReason   String?
  document         EsignDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user             User      @relation("EsignSignerUser", fields: [userId], references: [id])
  signatures       EsignSignature[]
  notifications    EsignNotification[]

  @@index([documentId])
  @@index([userId])
  @@unique([documentId, userId])
}

model EsignSignature {
  id                    String   @id @default(cuid())
  documentId            String
  signerId              String
  signatureAsset        String
  signatureMethod       String
  signatureHash         String
  confirmationTimestamp DateTime
  ipAddress             String?
  deviceInfo            String?
  createdAt             DateTime @default(now())
  document              EsignDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  signer                EsignSigner   @relation(fields: [signerId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([signerId])
}

model EsignProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  signaturePath String?
  signatureHash String?
  pinHash       String?
  pinUpdatedAt  DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Sesi percakapan tanda tangan via WhatsApp AI-Agent.
// Satu sesi aktif per (user, organisasi) — alur: intent "saya ttd" ->
// pilih dokumen (bila >1) -> kirim PIN -> dokumen tertandatangani.
// Sengaja tanpa @relation ke model lain (hanya kolom skalar) agar tidak
// mengubah model existing; baris kedaluwarsa dihapus malas (lazy) saat
// sesi diakses, dan PIN TIDAK PERNAH disimpan di sini.
model EsignWaSignSession {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  conversationId String
  documentId     String?
  signerId       String?
  // 'AWAITING_DOC' = menunggu user memilih nomor dokumen;
  // 'AWAITING_PIN' = menunggu user mengirim PIN (dokumen sudah dipilih).
  state          String
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([expiresAt])
}

model EsignTemplate {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  category       String
  filePath       String?
  generator      String?
  placeholders   String   @default("{}")
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      User     @relation("EsignTemplateAuthor", fields: [createdById], references: [id])

  @@index([organizationId])
}

model EsignAuditLog {
  id           String   @id @default(cuid())
  documentId   String
  userId       String?
  action       String
  metadata     String   @default("{}")
  ipAddress    String?
  userAgent    String?
  documentHash String?
  createdAt    DateTime @default(now())
  document     EsignDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user         User?    @relation("EsignAuditLogUser", fields: [userId], references: [id])

  @@index([documentId, createdAt])
}

model EsignNotification {
  id             String   @id @default(cuid())
  documentId     String
  signerId       String?
  recipientId    String
  channel        String   @default("WHATSAPP")
  eventType      String
  deliveryStatus String   @default("PENDING")
  retryCount     Int      @default(0)
  error          String?
  waMessageId    String?
  sentAt         DateTime?
  createdAt      DateTime @default(now())
  document       EsignDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  signer         EsignSigner?  @relation(fields: [signerId], references: [id], onDelete: Cascade)
  recipient      User     @relation("EsignNotificationRecipient", fields: [recipientId], references: [id])

  @@unique([documentId, signerId, eventType])
}
