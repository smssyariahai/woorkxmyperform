// ---------------------------------------------------------------------------
// Modul Pengumuman — porting MyPerform (Gelombang 3, 2026-11-12).
// Announcement: SATU tabel untuk draft, terjadwal, dan terkirim (backup:
// announcement_drafts + scheduled_announcements + announcements —
// ketiganya menyimpan kolom isi yang SAMA; yang membedakan hanya status
// + scheduled_at/sent_at + hitung kirim email). Draft = status 'draft',
// terjadwal = status 'scheduled' + scheduledAt, terkirim = 'published'
// + sentAt. GlobalNotification backup TIDAK di-port sebagai tabel:
// kontennya di sini, pengiriman/baca per user di Notification.
// NotificationPreference: preferensi kanal notifikasi per user (backup:
// notification_preferences, user_email PK + prefs JSONB). Di WOORK
// per (organisasi, user); bentuk prefs mengikuti WAVE03_DESIGN.md §3.2:
// { announcement: { app, email }, announcementUrgent: { app, email } }.
// ---------------------------------------------------------------------------
model Announcement {
  id              String       @id @default(cuid())
  organizationId  String
  authorId        String
  title           String
  summary         String       @default("")
  content         String       @default("")
  imageUrl        String?
  category        String       @default("announcement")
  priority        String       @default("normal") // normal | penting | mendesak
  route           String       @default("")
  customRoute     String       @default("")
  targetMode      String       @default("all") // all | targeted
  target          Json         @default("{}")
  filters         Json         @default("{}")
  channels        Json         @default("{\"app\": true, \"email\": false}")
  recipientEmails Json         @default("[]") // snapshot email penerima saat publish
  status          String       @default("draft") // draft | scheduled | published
  scheduledAt     DateTime?
  sentAt          DateTime?
  emailStatus     String       @default("not_requested") // not_requested | pending | sent | partial | failed | not_configured | skipped
  emailSent       Int          @default(0)
  emailFailed     Int          @default(0)
  emailError      String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  author          User         @relation("AnnouncementAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@index([organizationId, scheduledAt])
}

model NotificationPreference {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  prefs          Json         @default("{}")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
}
// ---------------------------------------------------------------------------
// Modul TAL (To Achieve List) — porting MyPerform (Gelombang 4, 2026-11-12).
// Sumber SQL mentah: db/postgres/001_schema.sql (tal_tasks, tal_locks_reports,
// tal_monthly_locks, tal_cuti, tal_notifications, tal_user_notification_settings,
// tal_user_obligations, tal_deadline_settings, tal_settings,
// tal_routine_templates, tal_holidays, tal_audit_logs, tal_badges,
// user_badge_progress, user_trophy_room), 003_tal_locks_payload.sql (payload
// tal_locks_reports), 004_tal_aux_payload.sql (payload tal_holidays +
// tal_monthly_locks), 011_tal_team_visibility.sql.
// Perbedaan vs backup (semuanya per-organisasi di WOORK; backup user flat
// tanpa organisasi):
// - tal_notifications TIDAK dibuat: pakai model Notification woork
//   (type 'TAL_*', lihat WAVE04_FOUNDATION.md §5) — isi pesan + penerima
//   sama, baca/dibaca lewat /api/notifications yang sudah ada.
// - tal_user_notification_settings TIDAK dibuat: pakai NotificationPreference
//   Gelombang 3 (prefs Json; kunci 'tal' berisi seluruh TalUserNotification-
//   Settings backup — DND, kanal, trigger pengingat).
// - global_notifications backup TIDAK dibuat: padanannya Announcement
//   Gelombang 3 (publish -> Notification per penerima).
// - legacy_id backup TIDAK dibawa (tidak ada impor data legacy; pola Gel. 2).
// - Payload JSONB 003/004 dilipat ke kolom `payload` Json di model terkait.
// - Field `progress` tal_tasks TIDAK disimpan (004: tidak punya kolom di
//   backup dan tidak dipaksakan ke kolom lain) — dihitung client-side.
// - TalSetting hanya dipakai backup sebagai fallback kunci
//   'tal_deadline_settings'; di WOORK pakai TalDeadlineSetting.
// ---------------------------------------------------------------------------
model TalTask {
  id                    String    @id @default(cuid())
  organizationId        String
  // type: daily | weekly | monthly
  type                  String
  isAdditional          Boolean   @default(false)
  originalTaskId        String?
  taskDate              DateTime? @db.Date
  taskTime              String?
  weekNumber            Int?
  weekYear              Int?
  month                 Int?
  year                  Int?
  title                 String
  description           String?
  parentId              String?
  parentTitle           String?
  // category: result | non_result
  category              String    @default("non_result")
  targetValue           Float?
  targetUnit            String?
  targetCustomUnit      String?
  // priority: low | medium | high
  priority              String    @default("medium")
  assignedTo            Json      @default("[]")
  assignedUserEmails    Json      @default("[]")
  assignedUsers         Json      @default("[]")
  // status: todo | pending | on_progress | done
  status                String    @default("todo")
  notes                 String?
  attachments           Json      @default("[]")
  actualValue           Float?
  blockerCategory       String?
  blockerDescription    String?
  blockerReportedAt     DateTime?
  isRolledOver          Boolean   @default(false)
  rolloverAction        String?
  rolloverTargetDate    DateTime? @db.Date
  rolloverTargetWeek    Int?
  rolloverTargetYear    Int?
  rolloverTargetMonth   Int?
  cancelNotes           String?
  enableReminder        Boolean   @default(false)
  reminderType          String?
  reminderMinutesBefore Int?
  reminderTime          String?
  reminderLastTriggeredAt DateTime?
  orderNo               Int?
  userId                String
  userEmail             String?
  userName              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  originalTask          TalTask?     @relation("TalTaskOriginal", fields: [originalTaskId], references: [id], onDelete: SetNull)
  rolledOverTasks       TalTask[]    @relation("TalTaskOriginal")
  parent                TalTask?     @relation("TalTaskParent", fields: [parentId], references: [id], onDelete: SetNull)
  childTasks            TalTask[]    @relation("TalTaskParent")

  @@index([organizationId, userId, year, month])
  @@index([organizationId, userId, taskDate])
  @@index([organizationId, userId, weekYear, weekNumber])
  @@index([organizationId, status])
}

