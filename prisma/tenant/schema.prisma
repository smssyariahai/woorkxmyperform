generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/@prisma/tenant-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model CompanyTax {
  id             String    @id @default(cuid())
  organizationId String    @unique
  npwp15         String? // NPWP 15 digit (format lama)
  npwp16         String? // NPWP 16 digit (format baru)
  taxDate        DateTime? // Tanggal kena pajak
  taxpayerName   String? // Nama wajib pajak
  isTaxpayer     Boolean   @default(false) // Wajib pajak NPWP (Yes/No)
  taxIdNumber    String? // Nomor Identifikasi Wajib Pajak (16 digit; disinkronkan dengan npwp16 bila sama)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([organizationId])
}

model CompanyDocument {
  id             String    @id @default(cuid())
  organizationId String
  docType        String // KTP | SELFIE_KTP | FOTO_LOKASI_USAHA | IZIN_USAHA | SK_KEMENKUMHAM | ANGGARAN_DASAR | AKTA_PENDIRIAN | COMPANY_PROFILE | NPWP_PERUSAHAAN | SIUP | NIB | FOTO_LOKASI_PERUSAHAAN | KTP_PENGURUS | KTP_PIC
  label          String? // keterangan tambahan: nama pengurus / kategori foto (LUAR/DALAM)
  originalName   String
  storedName     String
  filePath       String // path relatif: uploads/perusahaan/<organizationId>/<file>
  mimeType       String
  originalSize   Int
  compressedSize Int
  status         String    @default("DIAJUKAN") // DIAJUKAN | TERVERIFIKASI | DITOLAK | PERLU_PERBAIKAN
  uploadedById   String
  uploadedAt     DateTime  @default(now())
  verifiedById   String?
  verifiedAt     DateTime?
  verifyNote     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([organizationId])
  @@index([organizationId, docType])
  @@index([organizationId, status])
  @@index([uploadedById])
}

model Agent {
  id                   String                     @id @default(cuid())
  organizationId       String
  name                 String
  role                 String
  description          String                     @default("")
  avatarColor          String                     @default("#007AFD")
  skills               String                     @default("[]")
  systemInstructions   String                     @default("")
  tools                String                     @default("[]")
  currentStatus        String                     @default("IDLE")
  currentTaskId        String?
  departmentId         String?
  // Fase 4 (§13): instance dari katalog template (master AgentTemplate).
  // String polos TANPA FK lintas DB (pola Opsi A); NULL = dibuat manual via UI.
  templateSlug         String?
  templateVersion      String?
  isEnabled            Boolean                    @default(true)
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  department           Department?                @relation("AgentDepartment", fields: [departmentId], references: [id], onDelete: SetNull)
  activities           AgentActivity[]
  layouts              OfficeLayout[]
  receivedMessages     AgentMessage[]             @relation("MsgReceiver")
  sentMessages         AgentMessage[]             @relation("MsgSender")
  tasks                AgentTask[]                @relation("TaskAgent")
  requestedApprovals   Approval[]                 @relation("ApprovalRequester")
  // Fase 5a (Staff Residence): penempatan kasur + jadwal/sesi istirahat.
  residenceAssignments AgentResidenceAssignment[]
  restSchedules        AgentRestSchedule[]
  restSessions         AgentRestSession[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([organizationId, currentStatus])
  @@index([departmentId])
  @@index([templateSlug])
}

model AgentTask {
  id               String         @id @default(cuid())
  organizationId   String
  title            String
  description      String         @default("")
  agentId          String?
  createdById      String?
  priority         String         @default("NORMAL")
  status           String         @default("QUEUED")
  progress         Int            @default(0)
  inputPayload     String         @default("{}")
  resultPayload    String?
  errorMessage     String?
  attempts         Int            @default(0)
  maxAttempts      Int            @default(3)
  requiresApproval Boolean        @default(false)
  createdAt        DateTime       @default(now())
  startedAt        DateTime?
  completedAt      DateTime?
  updatedAt        DateTime       @updatedAt
  messages         AgentMessage[]
  agent            Agent?         @relation("TaskAgent", fields: [agentId], references: [id])
  approvals        Approval[]
  events           TaskEvent[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([agentId])
}

model TaskEvent {
  id             String    @id @default(cuid())
  organizationId String
  taskId         String
  eventType      String
  message        String    @default("")
  payload        String    @default("{}")
  createdAt      DateTime  @default(now())
  task           AgentTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([taskId, createdAt])
}

model AgentMessage {
  id              String     @id @default(cuid())
  organizationId  String
  conversationId  String
  senderAgentId   String
  receiverAgentId String
  taskId          String?
  content         String
  status          String     @default("SENT")
  createdAt       DateTime   @default(now())
  receiver        Agent      @relation("MsgReceiver", fields: [receiverAgentId], references: [id], onDelete: Cascade)
  sender          Agent      @relation("MsgSender", fields: [senderAgentId], references: [id], onDelete: Cascade)
  task            AgentTask? @relation(fields: [taskId], references: [id])

  @@index([conversationId])
  @@index([taskId])
}

model AgentActivity {
  id             String    @id @default(cuid())
  organizationId String
  agentId        String
  activityType   String
  description    String    @default("")
  startedAt      DateTime  @default(now())
  endedAt        DateTime?
  metadata       String    @default("{}")
  agent          Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([agentId, startedAt])
}

model Approval {
  id                 String    @id @default(cuid())
  organizationId     String
  taskId             String
  requestedByAgentId String?
  approvalType       String    @default("GENERAL")
  description        String    @default("")
  status             String    @default("PENDING")
  reviewedById       String?
  reviewedAt         DateTime?
  createdAt          DateTime  @default(now())
  requestedBy        Agent?    @relation("ApprovalRequester", fields: [requestedByAgentId], references: [id])
  task               AgentTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([taskId])
}

model Role {
  id             String           @id @default(cuid())
  organizationId String?
  name           String
  description    String?
  isSystem       Boolean          @default(false)
  createdAt      DateTime         @default(now())
  invitations    Invitation[]
  memberships    Membership[]
  permissions    RolePermission[]

  @@unique([organizationId, name])
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  description String?
  module      String           @default("Umum")
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Membership {
  id             String             @id @default(cuid())
  userId         String
  organizationId String
  roleId         String
  status         String             @default("ACTIVE")
  joinedAt       DateTime           @default(now())
  departmentId   String?
  jobTitle       String?
  department     Department?        @relation(fields: [departmentId], references: [id])
  role           Role               @relation(fields: [roleId], references: [id])
  employment     UserEmployment?
  customValues   UserCustomValue[]
  moduleAccess   UserModuleAccess[]

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
  @@index([departmentId])
}

// Data personal pengguna (Sidebar 1 — Info Personal Data).
// Satu profil per User (berlaku lintas kantor); data ketenagakerjaan
// justru per Membership (UserEmployment) karena bisa berbeda per kantor.

// Kontak keluarga/kerabat pengguna (Sidebar 1 — Info Kontak Keluarga).

// Info ketenagakerjaan (Sidebar 2) — satu per Membership (per kantor).
model UserEmployment {
  id                 String     @id @default(cuid())
  membershipId       String     @unique
  companyName        String?
  employeeId         String? // ID karyawan
  organizationName   String? // Nama organisasi / unit
  position           String? // Posisi pekerjaan
  jobLevel           String? // Tingkat jabatan
  employmentStatus   String? // Tetap | Kontrak | Magang | Freelance | Percobaan
  branch             String? // Cabang
  joinDate           DateTime?
  endDate            DateTime? // Tanggal berakhirnya status kepegawaian
  grade              String? // Golongan
  classLevel         String? // Kelas
  managerId          String? // Manajer / Atasan Langsung (User di kantor yang sama)
  approvalApproverId String? // Alur persetujuan bila berbeda dari atasan langsung
  approvalNote       String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  membership         Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([employeeId])
}

// Pendidikan formal & informal (Sidebar 2 — Pendidikan & Pengalaman).

// Pengalaman kerja (Sidebar 2).

// Definisi field custom per kantor (Sidebar 3 — Info Tambahan).
model UserCustomFieldDef {
  id             String            @id @default(cuid())
  organizationId String
  label          String
  type           String // SHORT_TEXT | LONG_TEXT | NUMBER | CURRENCY | DATE | TIME | SELECT | BOOLEAN | EMAIL | PHONE | URL | FILE
  options        String? // JSON array string — pilihan untuk tipe SELECT
  required       Boolean           @default(false)
  sortOrder      Int               @default(0)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  values         UserCustomValue[]

  @@index([organizationId])
}

// Nilai field custom per Membership (per kantor).
model UserCustomValue {
  id           String             @id @default(cuid())
  membershipId String
  fieldDefId   String
  value        String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  membership   Membership         @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  fieldDef     UserCustomFieldDef @relation(fields: [fieldDefId], references: [id], onDelete: Cascade)

  @@unique([membershipId, fieldDefId])
  @@index([membershipId])
}

// Hak akses modul per pengguna (Sidebar 4) — override per user.
// Tanpa baris = ikut aturan kantor (modul paket). Baris allowed=false
// = modul itu dicabut untuk user ini (ditegakkan di assertPermission).
model UserModuleAccess {
  id           String     @id @default(cuid())
  membershipId String
  moduleKey    String // kunci modul baru (chat | hris | audit | dashboard | setting) atau kunci lama (inbox | crm | hr | ...)
  allowed      Boolean    @default(true)
  access       String     @default("WRITE") // READ | WRITE | NONE (baris lama allowed=false = NONE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([membershipId, moduleKey])
  @@index([membershipId])
}

// Penugasan role platform (Admin WOORK, Fase 1 RBAC).
// Berbeda dari Membership: tidak terikat satu tenant. Role yang ditugaskan
// HARUS role platform (Role.organizationId null); penegakannya di API,
// bukan di constraint database. Akses platform dicek lewat
// requirePlatformPermission, terpisah dari permission tenant.

model Department {
  id             String              @id @default(cuid())
  organizationId String
  name           String
  description    String?
  floor          Int?
  zone           String?
  capacity       Int?
  headUserId     String?
  isActive       Boolean             @default(true)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  agents         Agent[]             @relation("AgentDepartment")
  memberships    Membership[]
  workSchedules  WorkSchedule[]
  // Fase 5a (Staff Residence): jadwal istirahat per divisi.
  restSchedules  AgentRestSchedule[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Channel {
  id             String           @id @default(cuid())
  organizationId String
  type           String
  name           String
  status         String           @default("DISCONNECTED")
  createdAt      DateTime         @default(now())
  accounts       ChannelAccount[]
  conversations  Conversation[]

  @@unique([organizationId, type])
  @@index([organizationId])
}

model ChannelAccount {
  id             String    @id @default(cuid())
  organizationId String
  channelId      String
  externalId     String?
  displayName    String?
  credentials    String    @default("{}")
  verifyToken    String?
  status         String    @default("DISCONNECTED")
  lastTestAt     DateTime?
  lastTestOk     Boolean?
  lastError      String?
  connectedAt    DateTime?
  createdAt      DateTime  @default(now())
  channel        Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Customer {
  id             String              @id @default(cuid())
  organizationId String
  name           String
  phone          String?
  email          String?
  company        String?
  industry       String?
  source         String?
  business       String?
  interest       String?
  budget         String?
  stage          String              @default("Baru")
  score          String?
  ownerId        String?
  unreadCount    Int                 @default(0)
  lastMessageAt  DateTime?
  lastPurchase   String?
  nextFollowUp   DateTime?
  meta           String              @default("{}")
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  waLid          String?
  // Foto profil WA (disajikan via /api/customers/photo); null bila belum ada / privasi kontak menutup.
  photoUrl       String?
  // Terakhir kali foto profil WA dicek (berhasil maupun gagal) — dipakai untuk jeda refresh 7 hari.
  photoCheckedAt DateTime?
  activities     Activity[]
  recipients     CampaignRecipient[]
  conversations  Conversation[]
  tags           CustomerTag[]
  deals          Deal[]
  followUps      FollowUp[]
  lead           Lead?
  notes          Note[]

  @@index([organizationId])
  @@index([organizationId, stage])
  @@index([phone])
  @@index([email])
  @@index([ownerId])
  @@index([updatedAt])
}

model Tag {
  id             String        @id @default(cuid())
  organizationId String
  name           String
  color          String        @default("#087BFF")
  createdAt      DateTime      @default(now())
  customers      CustomerTag[]

  @@unique([organizationId, name])
}

model CustomerTag {
  customerId String
  tagId      String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([customerId, tagId])
}

model Conversation {
  id             String                @id @default(cuid())
  organizationId String
  customerId     String
  channelId      String?
  channelType    String                @default("WHATSAPP")
  status         String                @default("NEW")
  assignedTo     String                @default("WOO")
  assigneeId     String?
  lastMessageAt  DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  botEnabled     Boolean               @default(true)
  channel        Channel?              @relation(fields: [channelId], references: [id])
  customer       Customer              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  messages       ConversationMessage[]

  @@index([organizationId])
  @@index([customerId])
  @@index([organizationId, status])
  @@index([lastMessageAt])
}

model ConversationMessage {
  id             String       @id @default(cuid())
  conversationId String
  senderType     String
  senderId       String?
  body           String
  messageType    String       @default("TEXT")
  metadata       String       @default("{}")
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdAt])
}

model Note {
  id             String   @id @default(cuid())
  organizationId String
  customerId     String
  authorId       String
  body           String
  createdAt      DateTime @default(now())
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model Activity {
  id             String    @id @default(cuid())
  organizationId String
  customerId     String?
  actorId        String?
  type           String
  title          String
  description    String?
  createdAt      DateTime  @default(now())
  customer       Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([customerId])
  @@index([createdAt])
}

model LeadStage {
  id             String @id @default(cuid())
  organizationId String
  name           String
  order          Int    @default(0)
  color          String @default("#087BFF")
  leads          Lead[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Lead {
  id             String    @id @default(cuid())
  organizationId String
  customerId     String    @unique
  stageId        String
  ownerId        String?
  value          Float?
  score          String?
  source         String?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  customer       Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  stage          LeadStage @relation(fields: [stageId], references: [id])

  @@index([organizationId])
  @@index([stageId])
}

model DealStage {
  id             String @id @default(cuid())
  organizationId String
  name           String
  order          Int    @default(0)
  deals          Deal[]

  @@unique([organizationId, name])
}

model Deal {
  id              String    @id @default(cuid())
  organizationId  String
  customerId      String
  stageId         String
  title           String
  value           Float?
  ownerId         String?
  status          String    @default("OPEN")
  expectedCloseAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  customer        Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  stage           DealStage @relation(fields: [stageId], references: [id])

  @@index([organizationId])
}

model FollowUp {
  id             String   @id @default(cuid())
  organizationId String
  customerId     String
  assignedToId   String?
  scheduledAt    DateTime
  status         String   @default("PENDING")
  notes          String?
  createdAt      DateTime @default(now())
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([scheduledAt])
  @@index([status])
}

model Campaign {
  id             String              @id @default(cuid())
  organizationId String
  name           String
  channelType    String              @default("WHATSAPP")
  message        String
  status         String              @default("DRAFT")
  audienceFilter String              @default("{}")
  scheduledAt    DateTime?
  sentCount      Int                 @default(0)
  deliveredCount Int                 @default(0)
  readCount      Int                 @default(0)
  createdById    String
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  imagePath      String?
  recipients     CampaignRecipient[]

  @@index([organizationId])
  @@index([status])
}

model CampaignRecipient {
  id          String    @id @default(cuid())
  campaignId  String
  customerId  String
  phone       String
  status      String    @default("PENDING")
  error       String?
  sentAt      DateTime?
  waMessageId String?
  readAt      DateTime?
  campaign    Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  customer    Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([campaignId, phone])
  @@index([campaignId])
}

model BotFlow {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  description    String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  nodes          BotNode[]

  @@index([organizationId])
}

model BotNode {
  id       String  @id @default(cuid())
  flowId   String
  type     String
  name     String
  config   String  @default("{}")
  position String  @default("{}")
  order    Int     @default(0)
  flow     BotFlow @relation(fields: [flowId], references: [id], onDelete: Cascade)

  @@index([flowId])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  action         String
  module         String
  description    String?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  @@index([organizationId])
  @@index([organizationId, createdAt])
  @@index([action])
  @@index([module])
}

model Notification {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  type           String
  title          String
  body           String?
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([userId, isRead])
}

model Session {
  id             String   @id @default(cuid())
  userId         String
  organizationId String?
  tokenId        String   @unique
  ipAddress      String?
  userAgent      String?
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  @@index([userId])
}

model Invitation {
  id             String    @id @default(cuid())
  organizationId String
  email          String
  roleId         String
  token          String    @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  invitedById    String
  createdAt      DateTime  @default(now())
  role           Role      @relation(fields: [roleId], references: [id])

  @@unique([organizationId, email])
}

model Subscription {
  id               String               @id @default(cuid())
  organizationId   String               @unique
  plan             String               @default("FREE")
  status           String               @default("ACTIVE") // PENDING_PAYMENT | ACTIVE | EXPIRED | SUSPENDED | CANCELLED
  currentPeriodEnd DateTime?
  trialEndsAt      DateTime?
  // --- Sistem Modular (2026-11-07): langganan per modul + kuota karyawan ---
  billingCycle     String               @default("MONTHLY") // MONTHLY | YEARLY
  userQuota        Int                  @default(0) // 0 = tanpa batas (grandfathering data lama)
  startDate        DateTime?
  endDate          DateTime?
  modules          SubscriptionModule[]
  invoices         Invoice[]

  @@index([status])
}

/// Harga langganan per modul berbayar (per user). Diubah Administrator Pusat.

/// Modul yang diambil satu langganan + snapshot harga saat dibuat.
model SubscriptionModule {
  id                   String       @id @default(cuid())
  subscriptionId       String
  moduleKey            String // chat | hris | audit
  pricePerUserSnapshot Int
  status               String       @default("ACTIVE") // ACTIVE | INACTIVE
  createdAt            DateTime     @default(now())
  subscription         Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, moduleKey])
  @@index([subscriptionId])
}

/// Tagihan langganan (dibayar manual, dikonfirmasi Administrator Pusat).
model Invoice {
  id             String        @id @default(cuid())
  organizationId String
  subscriptionId String?
  number         String        @unique // INV/YYYY/MM/NNN
  status         String        @default("PENDING") // PENDING | PAID | OVERDUE | CANCELLED
  billingCycle   String        @default("MONTHLY")
  periodStart    DateTime
  periodEnd      DateTime
  subtotal       Int
  total          Int
  dueDate        DateTime
  paidAt         DateTime?
  paidNote       String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
  items          InvoiceItem[]

  @@index([organizationId])
  @@index([status])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  moduleKey   String?
  description String
  quantity    Int
  unitPrice   Int
  amount      Int
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model ReplyTemplate {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  category       String   @default("Umum")
  body           String
  isActive       Boolean  @default(true)
  usageCount     Int      @default(0)
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
  @@index([organizationId, isActive])
}

model HrVacancy {
  id             String        @id @default(cuid())
  organizationId String
  title          String
  department     String?
  location       String?
  employmentType String        @default("PKWTT")
  quota          Int           @default(1)
  status         String        @default("OPEN")
  description    String?
  salaryMin      Float?
  salaryMax      Float?
  publishedAt    DateTime?
  closedAt       DateTime?
  createdById    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  candidates     HrCandidate[]

  @@index([organizationId])
