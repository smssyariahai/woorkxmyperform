// ---------------------------------------------------------------------------
// Koperasi — porting MyPerform Gelombang 5 (fondasi 2026-11-13).
// Sumber: db/postgres/012_koperasi_anggota.sql (backup-main-2026-11-02).
// Foto KTP / foto anggota / tanda tangan di backup disimpan sebagai data URL
// (kolom foto_* TEXT); di WOORK disimpan sebagai FILE di disk
// (uploads/koperasi/, pola app/api/customers/photo +
// app/api/esign/profile/signature) — kolom foto_* di sini menyimpan PATH
// RELATIF (mis. "ktp-<id>.jpg"), BUKAN data URL.
// ---------------------------------------------------------------------------

model KoperasiAnggota {
  id                  String    @id @default(cuid())
  organizationId      String
  cabang              String    @default("")
  nik                 String
  namaLengkap         String
  tempatLahir         String    @default("")
  tanggalLahir        DateTime? @db.Date
  jenisKelamin        String    @default("")
  alamatKtp           String    @default("") @db.Text
  noHp                String    @default("")
  namaIbuKandung      String    @default("")
  pekerjaan           String    @default("")
  statusPerkawinan    String    @default("")
  penghasilanBulanan  String    @default("")
  tujuanKeanggotaan   String    @default("")
  fotoKtpPath         String    @default("")
  fotoAnggotaPath     String    @default("")
  tandaTanganPath     String    @default("")
  setujuMobileBanking Boolean   @default(false)
  setujuPernyataan    Boolean   @default(false)
  // Status kepemilikan produk; diisi modul Rekening Simpanan &
  // Pembiayaan saat modul itu tersedia (saat ini selalu false).
  hasSimpanan         Boolean   @default(false)
  hasPinjaman         Boolean   @default(false)
  createdBy           String    @default("")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([organizationId, nik])
  @@index([organizationId, namaLengkap])
  @@index([organizationId, cabang])
}

// Setting key-value per organisasi untuk modul Koperasi.
// key 'kirim_json': { urls: [{id, judul, url, deskripsi}], defaultUrlId: string|null }
// key 'cabang': { cabang: string[] }
model KoperasiSetting {
  id             String   @id @default(cuid())
  organizationId String
  key            String
  settings       Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, key])
}

// ---------------------------------------------------------------------------
// Modul Tiket — baru (Bagian 3, 2026-11-19).
// Tiket dukungan internal per kantor: dibuat user kantor, ditangani admin
// kantor (TIKET_MANAGE), diawasi Administrator Pusat lewat /admin/tiket.
// Tanpa lampiran file di v1. Kategori/prioritas/status disimpan sebagai
// string (pola AgentTask/TalTask), bukan enum — nilai baru tidak butuh
// migrasi. Notifikasi memakai model Notification (type 'TIKET').
// ---------------------------------------------------------------------------
model Ticket {
  id             String        @id @default(cuid())
  organizationId String
  createdById    String
  title          String
  category       String        @default("Umum") // Teknis/IT | HRD | Keuangan | Umum
  priority       String        @default("normal") // rendah | normal | tinggi | mendesak
  status         String        @default("TERBUKA") // TERBUKA | DIPROSES | MENUNGGU_BALASAN | SELESAI | DITUTUP
  description    String        @default("") @db.Text
  assignedToId   String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  replies        TicketReply[]

  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@index([createdById])
  @@index([assignedToId])
}

model TicketReply {
  id        String   @id @default(cuid())
  ticketId  String
  authorId  String
  content   String   @db.Text
  createdAt DateTime @default(now())
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

// ---------------------------------------------------------------------------
// Modul E-Arsip — baru (2026-11-19, Item 2).
// Arsip dokumen internal per kantor: kategori (mendukung subkategori via
// self-relation parentId) + dokumen dengan satu file per dokumen.
// Kerahasiaan/confidentiality & status disimpan sebagai string (pola
// Ticket), bukan enum — nilai baru tidak butuh migrasi.
// confidentiality: PUBLIC | INTERNAL | CONFIDENTIAL. Dokumen CONFIDENTIAL
// hanya boleh dilihat/diunduh Super Admin atau pemegang EARSIP_MANAGE
// (ditegakkan di BACKEND pada setiap endpoint baca/file, lib/earsip).
// status: ACTIVE | ARCHIVED (arsipkan = ubah status, bukan hapus).
// File disimpan di uploads/earsip/<organizationId>/, DB hanya menyimpan
// path relatif (pola Koperasi). TIDAK ADA tabel versi dokumen (ditunda)
// dan TIDAK ADA tabel log aktivitas arsip — aktivitas dicatat ke AuditLog
// existing via lib/audit.ts.
// ---------------------------------------------------------------------------
model ArchiveCategory {
  id             String            @id @default(cuid())
  organizationId String
  name           String
  description    String?
  parentId       String?
  createdById    String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  parent         ArchiveCategory?  @relation("ArchiveCategoryParent", fields: [parentId], references: [id], onDelete: Cascade)
  children       ArchiveCategory[] @relation("ArchiveCategoryParent")
  documents      ArchiveDocument[]

  @@index([organizationId])
  @@index([organizationId, parentId])
}

model ArchiveDocument {
  id              String          @id @default(cuid())
  organizationId  String
  categoryId      String
  title           String
  documentNumber  String?
  documentDate    DateTime?
  description     String?         @db.Text
  filePath        String // path relatif: uploads/earsip/<organizationId>/<file>
  fileName        String
  fileSize        Int
  mimeType        String
  uploaderId      String
  confidentiality String          @default("INTERNAL") // PUBLIC | INTERNAL | CONFIDENTIAL
  status          String          @default("ACTIVE") // ACTIVE | ARCHIVED
  uploadedAt      DateTime        @default(now())
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  category        ArchiveCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([organizationId, categoryId])
  @@index([organizationId, status])
  @@index([organizationId, confidentiality])
  @@index([organizationId, uploadedAt])
  @@index([uploaderId])
}

model Meeting {
  id                  String               @id @default(cuid())
  organizationId      String
  hostId              String // User pembuat/host
  title               String
  description         String?              @db.Text
  startsAt            DateTime // simpan UTC; tampilkan Asia/Jakarta (tidak ada timezone di User)
  endsAt              DateTime?
  timezone            String               @default("Asia/Jakarta")
  meetingType         String               @default("INTERNAL") // INTERNAL | EXTERNAL | DEPARTMENT | BRANCH | MANAGEMENT | TRAINING | WEBINAR | INTERVIEW
  locationType        String               @default("ONLINE") // ONLINE | OFFLINE | HYBRID
  joinUrl             String? // tautan eksternal (Zoom/Meet) bila dipakai; kosong bila video internal
  location            String? // alamat bila offline/hybrid
  status              String               @default("SCHEDULED") // DRAFT | SCHEDULED | ONGOING | COMPLETED | CANCELLED
  password            String? // hash bila meeting memakai password (jangan simpan plaintext)
  waitingRoom         Boolean              @default(false)
  allowJoinBeforeHost Boolean              @default(false)
  muteOnEntry         Boolean              @default(false)
  allowScreenShare    Boolean              @default(true)
  allowChat           Boolean              @default(true)
  allowRecording      Boolean              @default(false)
  isRecurring         Boolean              @default(false)
  recurrenceRule      String? // RRULE; atau Json — putuskan di Fase 2
  roomName            String?              @unique // mis. "meet_<id>"; nama room video internal (agnostik engine)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  participants        MeetingParticipant[]
  agendaItems         MeetingAgendaItem[]
  notes               MeetingNote[]
  recordings          MeetingRecording[]
  chatMessages        MeetingChatMessage[]
  sessions            MeetingSession[]
  guestTokens         MeetingGuestToken[]

  @@index([organizationId, startsAt])
  @@index([organizationId, status])
  @@index([hostId])
}

model MeetingParticipant {
  id                 String             @id @default(cuid())
  meetingId          String
  userId             String? // null = tamu eksternal (snapshot di bawah, pola EsignSigner)
  guestName          String?
  guestEmail         String?
  guestPhone         String?
  snapshotPosition   String? // jabatan saat diundang
  snapshotDepartment String?
  snapshotBranch     String? // string bebas (tidak ada model Branch)
  role               String             @default("PARTICIPANT") // HOST | CO_HOST | PARTICIPANT
  isRequired         Boolean            @default(true)
  status             String             @default("INVITED") // INVITED | ACCEPTED | DECLINED | TENTATIVE | ATTENDED | ABSENT
  respondedAt        DateTime?
  joinedAt           DateTime?
  leftAt             DateTime?
  meeting            Meeting            @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  guestToken         MeetingGuestToken?

  @@unique([meetingId, userId]) // tamu (userId null) perlu penanganan khusus di Fase 2
  @@index([meetingId])
  @@index([userId])
}

// Token tamu publik — pola EsignSigner.accessToken (randomUUID, TTL, cabut dengan null).
model MeetingGuestToken {
  id             String             @id @default(cuid())
  meetingId      String
  participantId  String             @unique
  accessToken    String             @unique
  tokenExpiresAt DateTime?
  scope          String             @default("JOIN") // JOIN | VIEW
  revokedAt      DateTime?
  createdAt      DateTime           @default(now())
  meeting        Meeting            @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  participant    MeetingParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([meetingId])
}

model MeetingSession {
  id              String    @id @default(cuid())
  meetingId       String
  participantId   String?
  userId          String?
  guestName       String?
  joinedAt        DateTime  @default(now())
  leftAt          DateTime?
  durationSeconds Int?
  meeting         Meeting   @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId])
}

model MeetingChatMessage {
  id          String   @id @default(cuid())
  meetingId   String
  senderId    String? // null = tamu (nama dari snapshot)
  senderName  String
  body        String   @db.Text
  isPrivate   Boolean  @default(false)
  recipientId String? // bila private message
  createdAt   DateTime @default(now())
  meeting     Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId, createdAt])
}

model MeetingRecording {
  id              String   @id @default(cuid())
  meetingId       String
  filePath        String // relatif uploads/meet/<orgId>/ — pola ArchiveDocument.filePath
  fileName        String
  fileSize        Int
  mimeType        String
  durationSeconds Int?
  uploaderId      String
  confidentiality String   @default("INTERNAL") // PUBLIC | INTERNAL | CONFIDENTIAL
  status          String   @default("ACTIVE") // ACTIVE | ARCHIVED
  createdAt       DateTime @default(now())
  meeting         Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId])
}

model MeetingSetting {
  id                     String   @id @default(cuid())
  organizationId         String   @unique
  maxDurationMinutes     Int      @default(120)
  maxParticipants        Int      @default(50)
  waitingRoomDefault     Boolean  @default(false)
  allowGuest             Boolean  @default(true)
  allowScreenShare       Boolean  @default(true)
  allowChat              Boolean  @default(true)
  allowRecording         Boolean  @default(false)
  recordingRetentionDays Int      @default(30)
  defaultTimezone        String   @default("Asia/Jakarta")
  updatedAt              DateTime @updatedAt
}

model MeetingAgendaItem {
  id              String  @id @default(cuid())
  meetingId       String
  title           String
  description     String? @db.Text
  durationMinutes Int?
  order           Int     @default(0)
  presenterId     String?
  status          String  @default("PENDING")
  meeting         Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId])
}

model MeetingNote {
  id        String   @id @default(cuid())
  meetingId String
  authorId  String
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId])
}

// ============================================================
// WOORK WORK CALENDAR — kalender kerja terpusat (2026-11-21).
// Satu sumber data jadwal untuk seluruh ekosistem WOORK.
// Event manual (sourceModule NULL) + event sinkron dari modul
// sumber (meeting, tal_task, tal_cuti, invoice, announcement,
// holiday). Integrasi idempotent via @@unique(sourceModule,
// sourceRecordId); modul sumber tetap pemilik data bisnisnya.
// Holiday TIDAK diduplikasi — TalHoliday dibaca langsung.
// ============================================================
model CalendarEvent {
  id                        String    @id @default(cuid())
  organizationId            String
  createdById               String
  // Modul sumber; NULL = event manual (dibuat di kalender).
  sourceModule              String?
  sourceRecordId            String?
  title                     String
  description               String?   @db.Text
  // meeting | task | project | hr | leave | attendance | training |
  // company | personal | finance | reminder | other
  category                  String    @default("other")
  startAt                   DateTime
  endAt                     DateTime
  timezone                  String    @default("Asia/Jakarta")
  isAllDay                  Boolean   @default(false)
  location                  String?
  meetingLink               String?
  // PRIVATE | TEAM | DEPARTMENT | COMPANY | CUSTOM
  visibility                String    @default("COMPANY")
  // SCHEDULED | COMPLETED | CANCELLED
  status                    String    @default("SCHEDULED")
  // RRULE (rrule.js) untuk event berulang; NULL = tidak berulang.
  recurrenceRule            String?
  // Instance pengecualian (edit satu instance): menunjuk ke event induk.
  recurrenceParentId        String?
  recurrenceOriginalStartAt DateTime?
  metadata                  Json      @default("{}")
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  recurrenceParent     CalendarEvent?     @relation("CalendarRecurrence", fields: [recurrenceParentId], references: [id], onDelete: Cascade)
  recurrenceExceptions CalendarEvent[]    @relation("CalendarRecurrence")
  attendees            CalendarAttendee[]
  reminders            CalendarReminder[]
  syncLogs             CalendarSyncLog[]

  @@unique([sourceModule, sourceRecordId])
  @@index([organizationId, startAt])
  @@index([organizationId, status])
  @@index([createdById])
  @@index([recurrenceParentId])
}

model CalendarAttendee {
  id             String    @id @default(cuid())
  eventId        String
  userId         String
  // PENDING | ACCEPTED | DECLINED | TENTATIVE
  responseStatus String    @default("PENDING")
  respondedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  event CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId])
}

model CalendarReminder {
  id             String    @id @default(cuid())
  eventId        String
  userId         String
  minutesBefore  Int
  remindAt       DateTime
  // PENDING | SENT | FAILED
  deliveryStatus String    @default("PENDING")
  sentAt         DateTime?
  createdAt      DateTime  @default(now())

  event CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([remindAt, deliveryStatus])
  @@index([userId])
}

model CalendarSyncLog {
  id             String   @id @default(cuid())
  organizationId String
  sourceModule   String
  sourceRecordId String
  eventId        String?
  // SYNCED | FAILED | PENDING
  syncStatus     String   @default("PENDING")
  errorMessage   String?  @db.Text
  retryCount     Int      @default(0)
  lastSyncedAt   DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  event CalendarEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([sourceModule, sourceRecordId])
  @@index([organizationId, lastSyncedAt])
}

model CalendarUserPreference {
  id                      String   @id @default(cuid())
  userId                  String
  organizationId          String
  defaultView             String   @default("month") // day | week | month | agenda | year | timeline
  timezone                String   @default("Asia/Jakarta")
  firstDayOfWeek          Int      @default(1) // 0 = Minggu, 1 = Senin
  workingHours            Json     @default("{}")
  notificationPreferences Json     @default("{}")
  visibleCalendars        Json     @default("[]")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@unique([userId, organizationId])
}

// ============================================================
// WOORK DAILY WORKSPACE — pusat aktivitas & produktivitas harian
// (2026-11-21). HANYA agregasi + navigasi: tugas dari TalTask,
// agenda dari CalendarEvent, meeting dari Meeting, pengingat dari
// Notification. TIDAK ada penyimpanan tugas/kalender baru di sini.
// Dua model baru hanya untuk catatan harian + preferensi widget.
// Zona waktu TIDAK diduplikasi — baca CalendarUserPreference.
// ============================================================
model DailyWorkNote {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  // Satu catatan per pengguna per hari (upsert).
  date           DateTime @db.Date
  title          String?
  content        String?  @db.Text
  // PRIVATE | TEAM | MANAGER (default PRIVATE — tidak jadi laporan
  // perusahaan tanpa persetujuan pengguna).
  visibility     String   @default("PRIVATE")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, userId, date])
  @@index([organizationId, userId])
}

model DailyWorkspacePreference {
  id                  String   @id @default(cuid())
  organizationId      String
  userId              String
  layoutConfiguration Json     @default("{}")
  visibleWidgets      Json     @default("[]")
  widgetOrder         Json     @default("[]")
  quickActions        Json     @default("[]")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([organizationId, userId])
}

// ============================================================
// WOORK ATTENDANCE — absensi terpadu website + WhatsApp AI-Agent
// (2026-11-21). SATU backend/engine/DB untuk kedua kanal.
// Cuti/izin TIDAK diduplikasi — pakai TalCuti yang sudah ada.
// Lokasi kantor default bisa diambil dari Organization lat/lng
// (modul perusahaan); AttendanceLocation untuk multi-lokasi/cabang.
// Jam disimpan "HH:MM" (string) agar bebas zona waktu; tanggal
// kerja DateTime @db.Date (Asia/Jakarta). Status pakai String
// mengikuti pola model lain di schema ini.
// ============================================================
model AttendanceLocation {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  address        String?
  latitude       Float
  longitude      Float
  // Radius geofence dalam meter (default 100).
  radiusMeters   Int      @default(100)
  isDefault      Boolean  @default(false)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  records  AttendanceRecord[]
  settings AttendanceSetting[]

  @@index([organizationId, isActive])
}

model Shift {
  id               String   @id @default(cuid())
  organizationId   String
  name             String
  // Jam "HH:MM". Bila endTime < startTime = shift malam (lintas hari).
  startTime        String
  endTime          String
  isNightShift     Boolean  @default(false)
  breakMinutes     Int      @default(60)
  graceLateMinutes Int      @default(15)
  color            String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  records AttendanceRecord[]

  @@index([organizationId, isActive])
}

model WorkSchedule {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  // Jadwal personal bila userId terisi; jadwal departemen bila
  // departmentId terisi; keduanya NULL = template default organisasi.
  userId         String?
  departmentId   String?
  // {0: shiftId|null, 1: shiftId, ..., 6: shiftId} — 0=Minggu.
  // null = libur hari itu.
  daysOfWeek     Json      @default("{}")
  isDefault      Boolean   @default(false)
  isActive       Boolean   @default(true)
  effectiveFrom  DateTime? @db.Date
  effectiveTo    DateTime? @db.Date
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  department Department?        @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  records    AttendanceRecord[]

  @@index([organizationId, userId])
  @@index([organizationId, departmentId])
}

model AttendanceRecord {
  id              String    @id @default(cuid())
  organizationId  String
  userId          String
  date            DateTime  @db.Date
  shiftId         String?
  scheduleId      String?
  locationId      String?
  checkInAt       DateTime?
  checkInLat      Float?
  checkInLng      Float?
  // WEB | WHATSAPP | MANUAL (koreksi HRD)
  checkInMethod   String?
  checkInNote     String?
  checkOutAt      DateTime?
  checkOutLat     Float?
  checkOutLng     Float?
  checkOutMethod  String?
  checkOutNote    String?
  // PRESENT | LATE | EARLY_LEAVE | ABSENT | ON_LEAVE | HOLIDAY | INCOMPLETE
  status          String    @default("INCOMPLETE")
  lateMinutes     Int       @default(0)
  earlyMinutes    Int       @default(0)
  overtimeMinutes Int       @default(0)
  workMinutes     Int       @default(0)
  breakMinutes    Int       @default(0)
  isRemote        Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  shift       Shift?                 @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  schedule    WorkSchedule?          @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  location    AttendanceLocation?    @relation(fields: [locationId], references: [id], onDelete: SetNull)
  corrections AttendanceCorrection[]

  @@unique([organizationId, userId, date])
  @@index([organizationId, userId])
  @@index([organizationId, date])
}

model AttendanceCorrection {
  id             String    @id @default(cuid())
  organizationId String
  recordId       String
  requestedById  String
  // CHECK_IN | CHECK_OUT | STATUS | DATE
  type           String
  reason         String
  // Nilai yang diminta, mis. {checkInAt: "...", note: "..."}.
  requestedValue Json      @default("{}")
  // PENDING | APPROVED | REJECTED
  status         String    @default("PENDING")
  reviewedById   String?
  reviewedAt     DateTime?
  reviewNote     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  record AttendanceRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@index([organizationId, recordId])
  @@index([organizationId, status])
}

model OvertimeRequest {
  id             String    @id @default(cuid())
  organizationId String
  userId         String
  date           DateTime  @db.Date
  startTime      String
  endTime        String
  reason         String
  // PENDING | APPROVED | REJECTED
  status         String    @default("PENDING")
  approvedById   String?
  approvedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([organizationId, userId])
  @@index([organizationId, status])
}

model AttendanceSetting {
  id                 String   @id @default(cuid())
  organizationId     String   @unique
  requireGeofence    Boolean  @default(true)
  allowRemoteCheckIn Boolean  @default(false)
  defaultLocationId  String?
  graceLateMinutes   Int      @default(15)
  // Hari kerja default (1=Senin .. 5=Jumat); 0=Minggu, 6=Sabtu.
  workDays           Json     @default("[1,2,3,4,5]")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  defaultLocation AttendanceLocation? @relation(fields: [defaultLocationId], references: [id], onDelete: SetNull)
}

// ============================================================
// WOORK VIRTUAL OFFICE — MUSALA & PRAYER ACTIVITY (2026-11-21).
// Jadwal salat: AlAdhan API method 20 (Kemenag RI) dengan fallback
// rumus astronomis Kemenag (lib/islami/prayerTimeService.ts).
// Lokasi default Jakarta (sama seperti modul Islami); admin WAJIB
// mengonfirmasi lokasi perusahaan di pengaturan (org WOORK.ID belum
// punya lat/lng). Sesi salat: state bersama per-org in-memory
// (lib/kantor/prayer-session.ts, pola Tidur/Tema) + persistensi DB.
// Morning Briefing 08:00 BELUM ADA sistemnya (hanya template rutin
// TAL) — scheduler punya guard agar sesi salat tidak bentrok bila
// briefing kelak dibangun; praktisnya waktu salat tak pernah jatuh
// 08:00 (Subuh ~04:38, Zuhur ~11:xx, Asar ~15:xx, Magrib ~17:xx,
// Isya ~18:xx).
// ============================================================
model PrayerTimeSettings {
  id                     String   @id @default(cuid())
  organizationId         String   @unique
  isEnabled              Boolean  @default(true)
  latitude               Float    @default(-6.2088)
  longitude              Float    @default(106.8456)
  cityName               String?
  timezone               String   @default("Asia/Jakarta")
  // "kemenag" = AlAdhan method 20; "astronomical" = rumus Kemenag lokal.
  calculationMethod      String   @default("kemenag")
  // "shafii" (bayangan 1) | "hanafi" (bayangan 2).
  asrMethod              String   @default("shafii")
  adjustmentMinutes      Int      @default(0)
  sessionDurationMinutes Int      @default(10)
  enableAnimation        Boolean  @default(true)
  autoReturn             Boolean  @default(true)
  excludedAgentIds       Json     @default("[]")
  defaultImamAgentId     String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model DailyPrayerSchedule {
  id             String   @id @default(cuid())
  organizationId String
  prayerDate     DateTime @db.Date
  fajrTime       String
  dhuhrTime      String
  asrTime        String
  maghribTime    String
  ishaTime       String
  imsakTime      String?
  sunriseTime    String?
  // "kemenag_api" | "kemenag_astronomical"
  source         String   @default("kemenag_astronomical")
  cityName       String?
  latitude       Float
  longitude      Float
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, prayerDate])
  @@index([organizationId, prayerDate])
}

model PrayerSession {
  id               String    @id @default(cuid())
  organizationId   String
  // "subuh" | "dzuhur" | "ashar" | "maghrib" | "isya"
  prayerName       String
  prayerDate       DateTime  @db.Date
  scheduledAt      DateTime
  startedAt        DateTime?
  endedAt          DateTime?
  // SCHEDULED | IN_PROGRESS | COMPLETED | MISSED | STOPPED
  status           String    @default("SCHEDULED")
  participantCount Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  participants PrayerSessionParticipant[]

  @@unique([organizationId, prayerDate, prayerName])
  @@index([organizationId, prayerDate])
}

model PrayerSessionParticipant {
  id              String    @id @default(cuid())
  sessionId       String
  agentId         String
  agentName       String?
  isImam          Boolean   @default(false)
  initialRoom     String?
  initialPosition Json?
  prayerPosition  Json?
  // INVITED | WALKING | PRAYING | RETURNED | COMPLETED | SKIPPED
  status          String    @default("INVITED")
  arrivedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  session PrayerSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, agentId])
  @@index([sessionId])
}

// ============================================================
// WOORK VIRTUAL OFFICE — MORNING BRIEFING (2026-11-21).
// Briefing harian 08:00 WIB di ruang meeting. State bersama per-org
// in-memory (lib/kantor/briefing-session.ts, pola Tidur/Tema/Salat)
// + persistensi DB. Monitor ruang meeting = slideshow dinamis
// (branding, agenda, kalender, tugas — data NYATA, bukan angka
// karangan). TV menampilkan woork.id BILA bisa di-embed (cek
// X-Frame-Options/CSP); bila diblokir, fallback slideshow branding.
// ============================================================
model BriefingSettings {
  id                 String   @id @default(cuid())
  organizationId     String   @unique
  isEnabled          Boolean  @default(true)
  startTime          String   @default("08:00")
  timezone           String   @default("Asia/Jakarta")
  durationMinutes    Int      @default(10)
  preparationMinutes Int      @default(2)
  meetingLeaderId    String?
  // "all" | "selected" (bila selected, pakai excludedAgentIds terbalik:
  // hanya agent yang TIDAK dikecualikan — sederhanakan: excludedAgentIds)
  participantMode    String   @default("all")
  excludedAgentIds   Json     @default("[]")
  autoReturn         Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model BriefingSession {
  id               String    @id @default(cuid())
  organizationId   String
  scheduledDate    DateTime  @db.Date
  scheduledAt      DateTime
  startedAt        DateTime?
  endedAt          DateTime?
  // SCHEDULED | PREPARING | AGENTS_MOVING | GATHERING | IN_PROGRESS | CLOSING | RETURNING | COMPLETED | FAILED
  status           String    @default("SCHEDULED")
  participantCount Int       @default(0)
  meetingLeaderId  String?
  errorMessage     String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  participants BriefingParticipant[]

  @@unique([organizationId, scheduledDate])
  @@index([organizationId, scheduledDate])
}

model BriefingParticipant {
  id              String    @id @default(cuid())
  sessionId       String
  agentId         String
  agentName       String?
  isLeader        Boolean   @default(false)
  initialRoom     String?
  initialPosition Json?
  meetingPosition Json?
  // INVITED | MOVING | SEATED | PRESENTING | RETURNED | COMPLETED | SKIPPED
  status          String    @default("INVITED")
  arrivedAt       DateTime?
  leftAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  session BriefingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, agentId])
  @@index([sessionId])
}

// ---------------------------------------------------------------------------
// Mirror Organization & User — LAPISAN E (multi-tenant v2).
// Salinan lokal skalar saja (TANPA @relation) dari model Organization/User
// di prisma/schema.prisma. Master tetap otoritas identitas + registry;
// organizationId di tenant DB = Tenant.id di master; userId di model
// bisnis TETAP string tanpa FK (Opsi A).
// - Organization: SEMUA field skalar model utama (termasuk logo, modul
//   Manajemen Perusahaan, lat/lng, profileStatus).
// - User: field yang dibaca/ditulis kode aplikasi (audit Lapisan E:
//   id, email, name, username, avatar, phone, status, isSuperAdmin,
//   emailVerified, createdAt, updatedAt). Field `password` SENGAJA TIDAK
//   ADA — kata sandi hanya hidup di master (PlatformUser.passwordHash);
//   alur login/ganti password harus lewat master (lihat Lapisan F).
// - Query dengan include/_count relasi (mis. organization -> subscription,
//   _count memberships; user -> _count sentMessages/ownedLeads) TIDAK bisa
//   dilayani mirror ini — harus jadi query terpisah di Lapisan F.
// ---------------------------------------------------------------------------
model Organization {
  id                 String    @id @default(cuid())
  name               String
  slug               String    @unique
  logo               String?
  industry           String?
  teamSize           String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  isActive           Boolean   @default(true)
  modules            String    @default("[]")
  subdomain          String?   @unique
  description        String?
  tagline            String?
  phone              String?
  email              String?
  address            String?
  website            String?
  logoPath           String?
  coverPath          String?
  subdomainChangedAt DateTime?
  businessType       String?
  entityForm         String?
  country            String?   @default("Indonesia")
  province           String?
  city               String?
  district           String?
  village            String?
  postalCode         String?
  latitude           Float?
  longitude          Float?
  profileStatus      String    @default("BELUM_LENGKAP")
  profileCompletedAt DateTime?

  @@index([slug])
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  username      String?   @unique
  avatar        String?
  phone         String?
  status        String    @default("ACTIVE")
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  isSuperAdmin  Boolean   @default(false)

  @@index([status])
}

// ── WOORK STAFF RESIDENCE (Fase 5a, 2026-11-23 — spec §15) ───────────────
// Mess karyawan + sistem istirahat agent. Satu sumber kebenaran geometri
// adalah layout (residenceBeds() di office3d-layout.ts); DB menyimpan
// penempatan (bedIndex) bukan duplikat koordinat. Satu agent ↔ satu bed
// aktif ditegakkan DB (@@unique agentId + bedId di Assignment).
model Residence {
  id          String                     @id @default(cuid())
  name        String
  status      String                     @default("ACTIVE") // ACTIVE | INACTIVE
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt
  rooms       ResidenceRoom[]
  assignments AgentResidenceAssignment[]

  @@index([status])
}

model ResidenceRoom {
  id          String                     @id @default(cuid())
  residenceId String
  name        String // Kamar 1–4
  floorNumber Int                        @default(2)
  capacity    Int                        @default(4)
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt
  residence   Residence                  @relation(fields: [residenceId], references: [id], onDelete: Cascade)
  beds        ResidenceBed[]
  assignments AgentResidenceAssignment[]

  @@unique([residenceId, name])
  @@index([residenceId])
}

model ResidenceBed {
  id          String                     @id @default(cuid())
  roomId      String
  bedCode     String // K1-B1..K4-B4
  bedIndex    Int // 0–15, kunci ke residenceBeds() (per kamar: baris utara dulu, kolom barat dulu)
  status      String                     @default("AVAILABLE") // AVAILABLE | MAINTENANCE (OCCUPIED dihitung dari Assignment)
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt
  room        ResidenceRoom              @relation(fields: [roomId], references: [id], onDelete: Cascade)
  assignments AgentResidenceAssignment[]
  sessions    AgentRestSession[]

  @@unique([roomId, bedCode])
  @@unique([roomId, bedIndex])
  @@index([roomId])
}

model AgentResidenceAssignment {
  id          String        @id @default(cuid())
  agentId     String
  residenceId String
  roomId      String
  bedId       String
  assignedAt  DateTime      @default(now())
  status      String        @default("ACTIVE") // ACTIVE | INACTIVE
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  agent       Agent         @relation(fields: [agentId], references: [id], onDelete: Cascade)
  residence   Residence     @relation(fields: [residenceId], references: [id], onDelete: Cascade)
  room        ResidenceRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  bed         ResidenceBed  @relation(fields: [bedId], references: [id], onDelete: Cascade)

  @@unique([agentId])
  @@unique([bedId])
  @@index([residenceId])
  @@index([roomId])
}

model AgentRestSchedule {
  id           String      @id @default(cuid())
  agentId      String?
  divisionId   String?
  startTime    String // "HH:mm" WIB
  endTime      String // "HH:mm" WIB
  timezone     String      @default("Asia/Jakarta")
  scheduleType String      @default("NIGHT") // NIGHT | REST | BREAK
  enabled      Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  agent        Agent?      @relation(fields: [agentId], references: [id], onDelete: Cascade)
  division     Department? @relation(fields: [divisionId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([divisionId])
}

model AgentRestSession {
  id        String       @id @default(cuid())
  agentId   String
  bedId     String
  startedAt DateTime     @default(now())
  endedAt   DateTime?
  status    String       @default("RESTING") // RESTING | COMPLETED | CANCELLED
  source    String       @default("SCHEDULE") // SCHEDULE | MANUAL
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  agent     Agent        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  bed       ResidenceBed @relation(fields: [bedId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([bedId])
  @@index([status])
}
