# Database (PostgreSQL)
DATABASE_URL="postgresql://woo:woo@127.0.0.1:5432/woork_saas?schema=public"

# Auth.js
AUTH_SECRET="ganti-dengan-string-acak-minimal-32-karakter"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (opsional — kosongkan untuk menonaktifkan tombol Google)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEXT_PUBLIC_GOOGLE_ENABLED="0"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Integrasi Meta (Facebook & Instagram Login) ---
# Buat aplikasi di https://developers.facebook.com/apps
META_APP_ID=""
META_APP_SECRET=""
# Token verifikasi webhook (samakan dengan yang diisikan di dashboard Meta)
META_VERIFY_TOKEN="woork-meta-webhook"
# URL publik aplikasi (untuk OAuth redirect)
NEXT_PUBLIC_APP_URL="https://woork-saas.xsramazys.dev"
